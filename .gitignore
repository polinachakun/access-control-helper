# ── Alloy runtime artifacts ───────────────────────────────────────────────────
# Counterexample folders created next to .als files during analysis.
# Named after the assertion (e.g. AppRoleCanGetObject-solution-0.md).
**/spec/
/fixed/
/minimal_fixture/
/output/
/output*/
/out/
/out2/
/vpce_and_abac_deny/
/identity_allow_only/
/explicit_deny_wins/
/permission_boundary_blocks/

# Alloy artifacts inside test folders
tests/unit/*/

# Stray .als files and their counterexample dirs in the project root
/*.als
/module_*/

# ── Evaluation artifacts ──────────────────────────────────────────────────────
# Generated by evaluation/evaluate.py.
# JSON result files ARE committed (thesis evidence — keep final named runs).
# .als files are intermediate and throwaway — gitignored.
evaluation/robustness/results/*.als
evaluation/robustness/__pycache__/
evaluation/robustness/module_*/
evaluation/robustness/tmp*/
evaluation/output/

# ── Go build output ───────────────────────────────────────────────────────────
access-control-helper

# ── JetBrains / GoLand ───────────────────────────────────────────────────────
.idea/
*.iml

# ── macOS metadata ────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store

# ── Claude Code internal ──────────────────────────────────────────────────────
.claude/worktrees/
.claude/plans/

# ── Temp directories (created by eval script and manual testing) ──────────────
/tmp/
/tmp*/
/test[0-9]*/
/test_*/
/svc_test/
/main/

# ── Evaluation results (intermediate, not thesis evidence) ───────────────────
evaluation/robustness/manual_review/

# ── Terraform state (contains real AWS account IDs and resource ARNs) ─────────
evaluation/manual_verification/**/terraform.tfstate
evaluation/manual_verification/**/terraform.tfstate*.backup
evaluation/manual_verification/**/.terraform/

# ── Leftover manual-run output folders in project root ───────────────────────
/s1/
/s2/
/scenario*/
