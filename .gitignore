/fixed/
/minimal_fixture/
/output/
/output*/
/out/
/out2/
/vpce_and_abac_deny/
/identity_allow_only/
/explicit_deny_wins/
/permission_boundary_blocks/

# Alloy artifacts inside test folders
tests/unit/*/

# Stray .als files and their counterexample dirs in the project root
/*.als
/module_*/

# ── Evaluation artifacts ──────────────────────────────────────────────────────
# Generated by eval/evaluate.py — .als files, JSON results, extracted .tf dirs.
eval/results/
eval/__pycache__/

